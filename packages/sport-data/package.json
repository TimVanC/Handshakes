{
  "name": "@handshakes/sport-data",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "esbuild scripts/generate.ts --bundle --platform=node --format=esm --outfile=scripts/.generate.mjs && node scripts/.generate.mjs",
    "examples": "esbuild scripts/examples.ts --bundle --platform=node --format=esm --outfile=scripts/.examples.mjs && node scripts/.examples.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
